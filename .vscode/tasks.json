// Ctrl+Shift+B runs npm run dev: the databases in Docker, then the API and the web app
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EventHub: npm run dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
